---
// Stroke icons, colour from currentColor. Always paired with a visible text label.
interface Props { name: "phone" | "telegram" | "whatsapp" | "arrow" | "pin"; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
const paths: Record<Props["name"], string> = {
