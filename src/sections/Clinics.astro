---
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import { clinics, hours, phoneMain } from "../data/parodent";
---
<Section id="clinics" class="section section--surface" rec="UX-R007,SE-R002,S-R009" labelledby="clinics-title">
  <div class="container">
    <div class="section__head">
      <h2 id="clinics-title">П’ять клінік у Львові</h2>
      <p class="section__lead">Графік однаковий для всіх адрес: {hours.full}.</p>
    </div>
    <ul class="doors">
      {clinics.map((c) => (
        <li class="door" id={c.id}>
          <img class="door__img" src={`img/${c.img}-360.webp`} srcset={`img/${c.img}-360.webp 360w, img/${c.img}-720.webp 720w`} sizes="(min-width: 768px) 128px, 96px" width="360" height="480" alt={c.alt} loading="lazy" decoding="async" />
          <div class="door__info">
            <h3>{c.address}</h3>
            <p class="door__meta">Львів</p>
          </div>
          <div class="door__act">
            <a class="btn" href={c.map} rel="noopener" target="_blank"><Icon name="pin" size={18} />Маршрут</a>
            <a class="btn" href={phoneMain.href} data-rec="SP-R004"><Icon name="phone" size={18} />Подзвонити</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .doors { display: grid; border-top: 1px solid var(--color-border-ui); }
  .door { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: var(--s-3) var(--s-4); padding-block: var(--s-4); border-bottom: 1px solid var(--color-border-ui); }
  .door__img { width: 96px; height: 128px; object-fit: cover; }
  .door__info { display: grid; align-content: center; gap: var(--s-1); }
  .door h3 { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); }
  .door__meta { color: var(--color-muted); font-size: var(--fs-small); }
  .door__act { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); }
  .door__act .btn { padding-inline: var(--s-3); }
  @media (min-width: 768px) {
    .door { grid-template-columns: 128px minmax(0, 1fr); grid-template-rows: 1fr auto; column-gap: var(--s-5); }
    .door__img { width: 128px; height: 170px; grid-row: 1 / 3; }
    .door__info { align-content: end; }
    .door__act { grid-column: 2; display: flex; flex-wrap: wrap; align-self: end; }
  }
  @media (min-width: 1024px) {
    .doors { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-7); border-top: 0; }
    .door { border-top: 1px solid var(--color-border-ui); border-bottom: 0; }
  }
</style>
